# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=debug
CLIENT_ORIGIN=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=livepoll

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_key_here
JWT_EXPIRY_HOURS=24
